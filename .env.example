TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Leave empty for the first launch, use /whoami, then add your numeric ID.
TELEGRAM_ALLOWED_USER_IDS=

# Both current DeepSeek V4 models support tool calling.
DEEPSEEK_MODEL=deepseek-v4-flash

# Shell commands run from this directory, and filesystem tools are rooted here.
AGENT_WORKSPACE=./agent_workspace

# Persistent per-chat memory. Keep this outside AGENT_WORKSPACE.
AGENT_MEMORY_DB=./.agent_memory/checkpoints.sqlite

# Small monitor window reads this heartbeat file.
AGENT_STATUS_FILE=./.agent_runtime/status.json

# Default: free local Telegram voice/audio transcription before agent handling.
# First use downloads the selected Whisper model into .agent_runtime.
TRANSCRIPTION_PROVIDER=local
LOCAL_TRANSCRIPTION_MODEL=base
LOCAL_TRANSCRIPTION_DEVICE=cpu
LOCAL_TRANSCRIPTION_COMPUTE_TYPE=int8
LOCAL_TRANSCRIPTION_MODEL_DIR=./.agent_runtime/whisper_models

# Optional OpenAI transcription settings. Used only with TRANSCRIPTION_PROVIDER=openai.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional ISO-639-1 language hint, e.g. en, zh, ja. Leave empty for auto-detect.
TRANSCRIPTION_LANGUAGE=

# Optional: enable Tavily remote MCP web search/extract/crawl tools.
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Optional JSON object passed to Tavily MCP as default parameters.
# Example: {"search_depth":"basic","max_results":5}
TAVILY_DEFAULT_PARAMETERS=
