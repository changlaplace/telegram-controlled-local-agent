TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=

# Leave empty for the first launch, use /whoami, then add your numeric ID.
TELEGRAM_ALLOWED_USER_IDS=

# Both current DeepSeek V4 models support tool calling.
DEEPSEEK_MODEL=deepseek-v4-flash

# Shell commands run from this directory, and filesystem tools are rooted here.
AGENT_WORKSPACE=./agent_workspace

# Persistent per-chat memory. Keep this outside AGENT_WORKSPACE.
AGENT_MEMORY_DB=./.agent_memory/checkpoints.sqlite
